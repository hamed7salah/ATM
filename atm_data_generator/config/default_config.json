    "maintenance": {
        "flm_repair_time_mean": 2.0,
        "flm_repair_time_std": 0.5,
        "slm_repair_time_mean": 8.0,
        "slm_repair_time_std": 2.0,
        "preventive_maintenance_interval_days": 90.0,
        "preventive_maintenance_duration_hours": 1.5
    },
    "daily_transaction_mean": 150.0,
    "daily_transaction_std": 50.0,
    "peak_hours": [
        10,
        11,
        12,
        13,
        14,
        17,
        18,
        19
    ],
    "healthy_to_degrading_prob": 0.001,
    "degrading_to_warning_prob": 0.05,
    "degrading_to_healthy_prob": 0.02,
    "warning_to_failed_prob": 0.3,
    "warning_to_degrading_prob": 0.1,
    "sudden_failure_prob": 0.2,
    "output_format": "csv",
    "output_path": "./data/output",
    "compress": true
